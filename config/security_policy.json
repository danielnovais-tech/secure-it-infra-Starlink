{
  "security_policy": {
    "version": "1.0",
    "last_updated": "2026-01-06",
    "applicable_to": "enterprise_starlink_deployments",
    
    "access_control": {
      "authentication": {
        "minimum_password_length": 16,
        "password_complexity": "high",
        "mfa_required": true,
        "mfa_methods": ["totp", "hardware_token", "biometric"],
        "session_management": {
          "max_session_duration_hours": 1,
          "idle_timeout_minutes": 15,
          "concurrent_sessions_limit": 3
        }
      },
      
      "authorization": {
        "model": "rbac",
        "principle": "least_privilege",
        "default_role": "viewer",
        "role_review_frequency_days": 90
      }
    },
    
    "network_security": {
      "firewall": {
        "default_policy": "deny_all",
        "stateful_inspection": true,
        "deep_packet_inspection": true,
        "geo_blocking": true
      },
      
      "vpn": {
        "required_for_remote_access": true,
        "protocol": "wireguard",
        "encryption_standard": "AES-256-GCM",
        "perfect_forward_secrecy": true
      },
      
      "starlink_specific": {
        "terminal_authentication": true,
        "encrypted_management_plane": true,
        "bandwidth_monitoring": true,
        "anomaly_detection": true
      }
    },
    
    "data_protection": {
      "classification": {
        "levels": ["public", "internal", "confidential", "restricted"],
        "default_level": "internal"
      },
      
      "encryption": {
        "data_at_rest": {
          "enabled": true,
          "algorithm": "AES-256-GCM",
          "key_rotation_days": 90
        },
        "data_in_transit": {
          "enabled": true,
          "minimum_tls_version": "1.3",
          "cipher_suites": [
            "TLS_AES_256_GCM_SHA384",
            "TLS_CHACHA20_POLY1305_SHA256"
          ]
        }
      },
      
      "backup": {
        "frequency": "daily",
        "retention_days": 90,
        "encrypted": true,
        "off_site_storage": true,
        "tested_recovery": "monthly"
      }
    },
    
    "threat_detection": {
      "ids_ips": {
        "enabled": true,
        "mode": "prevention",
        "signature_updates": "automatic",
        "behavioral_analysis": true
      },
      
      "monitoring": {
        "continuous_monitoring": true,
        "log_aggregation": true,
        "siem_integration": true,
        "threat_intelligence_feeds": true
      },
      
      "incident_response": {
        "playbooks_defined": true,
        "response_team": "24x7",
        "escalation_procedures": true,
        "forensics_capability": true
      }
    },
    
    "compliance": {
      "frameworks": [
        {
          "name": "SOC2",
          "type": "Type II",
          "trust_principles": ["security", "availability", "confidentiality"]
        },
        {
          "name": "ISO27001",
          "certification_status": "certified"
        },
        {
          "name": "GDPR",
          "applicable_regions": ["EU"],
          "dpo_assigned": true
        }
      ],
      
      "audit": {
        "frequency": "quarterly",
        "scope": "comprehensive",
        "external_audits": true,
        "penetration_testing": "annual"
      }
    },
    
    "operational_security": {
      "patch_management": {
        "critical_patches": "within_24_hours",
        "security_patches": "within_7_days",
        "regular_patches": "within_30_days",
        "testing_required": true
      },
      
      "vulnerability_management": {
        "scanning_frequency": "weekly",
        "remediation_sla": {
          "critical": "24_hours",
          "high": "7_days",
          "medium": "30_days",
          "low": "90_days"
        }
      },
      
      "change_management": {
        "approval_required": true,
        "testing_required": true,
        "rollback_plan_required": true,
        "documentation_required": true
      }
    }
  }
}
