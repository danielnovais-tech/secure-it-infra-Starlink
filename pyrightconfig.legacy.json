{
  "typeCheckingMode": "basic",
  "pythonPlatform": "Windows",
  "venvPath": ".",
  "venv": ".venv",

  "include": [
    "tests/**/*.py"
  ],

  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/*.egg-info",
    "docs/**",
    "examples/**",
    "data/**",
    "logs/**",
    "terraform/**",
    "kubernetes/**",
    "scripts/**",
    "armada-atlas/**",

    "example_usage.py",
    "examples.py",
    "test_*.py"
  ],

  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
