{
  "typeCheckingMode": "basic",
  "pythonPlatform": "Windows",
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "secure_it_starlink/**/*.py",
    "security/**/*.py",
    "security_modules/**/*.py",
    "incident_response/**/*.py",
    "sesf/**/*.py",
    "threat_detection/**/*.py",
    "vpn_manager/**/*.py",
    "src/starlink_security/**/*.py",
    "main.py",
    "smoke_test.py",
    "validate_logs.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/*.egg-info",
    "docs/**",
    "examples/**",
    "data/**",
    "logs/**",
    "terraform/**",
    "kubernetes/**",
    "scripts/**",
    "armada-atlas/**",
    "tests/**",
    "starlink_security.py",
    "starlink_security_auditor.py",
    "starlink_monitor.py",
    "starlink_metrics.py",
    "starlink_api.py",
    "example_usage.py",
    "examples.py",
    "test_*.py"
  ]
}
