# Starlink Monitor Configuration
# This file should be placed in /etc/starlink-monitor/config.env

# Starlink API endpoint (default is the standard Starlink dish IP)
STARLINK_API_ENDPOINT=http://192.168.100.1/api/status

# API timeout in seconds
API_TIMEOUT=10

# Update interval in seconds (how often to poll the API)
UPDATE_INTERVAL=5

# Maximum retries for failed API calls
MAX_RETRIES=3

# Event detection thresholds
LATENCY_THRESHOLD=100          # milliseconds
DOWNLINK_THRESHOLD=50          # Mbps
UPLINK_THRESHOLD=10            # Mbps
OBSTRUCTION_THRESHOLD=5        # percentage
