[Unit]
Description=Starlink Network Monitoring Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starlink
Group=starlink
WorkingDirectory=/opt/starlink-monitor
ExecStart=/usr/bin/python3 /opt/starlink-monitor/run_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/starlink-monitor /var/lib/starlink-monitor

# Environment
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/starlink-monitor/config.env

[Install]
WantedBy=multi-user.target
